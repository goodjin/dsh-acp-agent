{
  "name": "@goodjin2/dsh-acp-agent",
  "version": "0.3.0",
  "description": "DSH plugin: ACP agent framework with GLM and MiniMax model clients",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodjin/dsh-acp-agent.git"
  },
  "homepage": "https://github.com/goodjin/dsh-acp-agent#readme",
  "bugs": {
    "url": "https://github.com/goodjin/dsh-acp-agent/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3"
  },
  "main": "./src/entry.ts",
  "types": "./src/entry.ts",
  "exports": {
    ".": {
      "types": "./src/entry.ts",
      "default": "./src/entry.ts"
    },
    "./index": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./entry": {
      "types": "./src/entry.ts",
      "default": "./src/entry.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./roster-filter": {
      "types": "./src/roster-filter.ts",
      "default": "./src/roster-filter.ts"
    },
    "./zcode-quota": {
      "types": "./src/zcode-quota.ts",
      "default": "./src/zcode-quota.ts"
    },
    "./minimaxi-quota": {
      "types": "./src/minimaxi-quota.ts",
      "default": "./src/minimaxi-quota.ts"
    },
    "./codex-quota": {
      "types": "./src/usage-codex.ts",
      "default": "./src/usage-codex.ts"
    },
    "./claude-quota": {
      "types": "./src/usage-claude.ts",
      "default": "./src/usage-claude.ts"
    },
    "./grok-quota": {
      "types": "./src/grok-quota.ts",
      "default": "./src/grok-quota.ts"
    },
    "./health": {
      "types": "./src/health.ts",
      "default": "./src/health.ts"
    },
    "./delegation-route": {
      "types": "./src/delegation-route.ts",
      "default": "./src/delegation-route.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "bridge/",
    "lib/client.js",
    "lib/client.js.map",
    "src/**/*.ts",
    "tsdown.config.ts",
    "lib/src/doubao/**/*.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "build:client": "tsc -p tsconfig.json && tsdown"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "acp",
    "agent",
    "glm",
    "minimax",
    "coding-plan"
  ],
  "author": "goodjin",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "proper-lockfile": "^4.1.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^24.0.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.0-rc.2",
    "tsdown": "^0.15.0",
    "lightningcss": "^1.30.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.2.0-rc.2 <0.3"
  },
  "bin": {
    "doubao-acp": "./lib/src/doubao/main.js"
  }
}

{
  "name": "@goodjin/dsh-acp-agent",
  "version": "0.1.0",
  "description": "DSH plugin: ACP agent framework with GLM and MiniMax model clients",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodjin/dsh-acp-agent.git"
  },
  "homepage": "https://github.com/goodjin/dsh-acp-agent#readme",
  "bugs": {
    "url": "https://github.com/goodjin/dsh-acp-agent/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./src/entry.ts",
  "types": "./src/entry.ts",
  "exports": {
    ".": { "types": "./src/entry.ts", "default": "./src/entry.ts" },
    "./index": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./entry": { "types": "./src/entry.ts", "default": "./src/entry.ts" },
    "./roster-filter": { "types": "./src/roster-filter.ts", "default": "./src/roster-filter.ts" },
    "./zcode-quota": { "types": "./src/zcode-quota.ts", "default": "./src/zcode-quota.ts" },
    "./minimaxi-quota": { "types": "./src/minimaxi-quota.ts", "default": "./src/minimaxi-quota.ts" },
    "./codex-quota": { "types": "./src/usage-codex.ts", "default": "./src/usage-codex.ts" },
    "./claude-quota": { "types": "./src/usage-claude.ts", "default": "./src/usage-claude.ts" },
    "./mermaid-asset": { "types": "./src/mermaid-asset.ts", "default": "./src/mermaid-asset.ts" },
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "acp",
    "agent",
    "glm",
    "minimax",
    "coding-plan"
  ],
  "author": "goodjin",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "mermaid": "^11.16.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
